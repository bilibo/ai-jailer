result-*
# One host's managed-tree options (flake.nix, packages.managed); a
# `path:<checkout>` ref carries it, the published ref never does.
host.nix
# What a session hands the human: patches for files the hook refuses
# (devenv.nix, .envrc, ...), applied with `git apply`. The session scratchpad
# is private to the session.
proposals/
.direnv/
.devenv/
.claude/
# Covered by .claude/ above; listed so `aj init` on this checkout
# (scripts/install.sh runs it) finds the lines it ensures.
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
